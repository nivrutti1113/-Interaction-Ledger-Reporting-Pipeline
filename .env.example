# Environment variables configuration for Assignment A
# Copy this file to .env and configure secrets as needed.
# Do NOT commit .env to source control!

# Fernet 32 url-safe base64-encoded key for authenticated PII encryption (AES-128-CBC + HMAC)
# Example generation: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Secret key for deterministic phone HMAC-SHA256 blind index lookup
PHONE_HMAC_KEY=

# Path to SQLite database file (default: agentic.db)
DATABASE_PATH=agentic.db

# Path to schema directory (default: assignment-a-data/schemas)
SCHEMAS_DIR=assignment-a-data/schemas
